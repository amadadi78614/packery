# Optional: deliver enquiries by email via Resend (https://resend.com).
# Without these, enquiries are validated and logged on the server only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=S Packery Website <website@yourdomain.co.za>
# Optional: send EZ Accounting College applications to a different inbox (defaults to CONTACT_TO_EMAIL)
COLLEGE_TO_EMAIL=

# Google reviews (optional — section stays hidden until 5+ reviews at 4.5+ stars)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# "Review us on Google" link from Google Business Profile → Ask for reviews (button hidden until set)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
